{
  "scanSettings": {
    "configMode": "AUTO",
    "configExternalURL": "",
    "projectToken": "",
    "checkPolicies": false,
    "forceUpdate": false
  },
  "checkRunSettings": {
    "vulnerableCheckRunConclusionLevel": "failure",
    "displayMode": "diff"
  },
  "issueSettings": {
    "minSeverityLevel": "LOW",
    "issueType": "DEPENDENCY"
  },
  "remediateSettings": {
    "workflowRules": {
      "enabled": true
    }
  },
  "dockerSettings": {
    "scan": true,
    "dockerfilePaths": [
      "**/Dockerfile"
    ],
    "baseImages": [
      "docker.n8n.io/n8nio/n8n:latest",
      "postgres:16-alpine",
      "traefik:v3.1"
    ]
  }
}
