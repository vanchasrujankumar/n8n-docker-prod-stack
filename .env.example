# =============================================================================
# n8n Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all required values before deploying.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Domain & SSL
# ---------------------------------------------------------------------------
DOMAIN_NAME=n8n.example.com
N8N_HOST=n8n.example.com
SSL_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Database - PostgreSQL
# ---------------------------------------------------------------------------
DB_USER=n8n
DB_PASSWORD=generate_a_strong_random_password_here
DB_NAME=n8n_production

# ---------------------------------------------------------------------------
# n8n Encryption & Auth
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Generate: openssl rand -hex 32
N8N_USER_MANAGEMENT_JWT_SECRET=

# ---------------------------------------------------------------------------
# Traefik Dashboard Auth
# ---------------------------------------------------------------------------
# Generate: htpasswd -nb admin your_password_here | sed -e 's/\$/\$\$/g'
TRAEFIK_AUTH_USER=admin
TRAEFIK_AUTH_PASS_HASH=

# ---------------------------------------------------------------------------
# Cloudflare DNS Challenge (optional - for DNS-01 ACME)
# Leave empty for HTTP-01 challenge (default)
# ---------------------------------------------------------------------------
CF_API_EMAIL=
CF_DNS_API_TOKEN=

# ---------------------------------------------------------------------------
# n8n Execution Settings
# ---------------------------------------------------------------------------
EXECUTIONS_PROCESS_LIMIT=5
N8N_LOG_LEVEL=info
N8N_METRICS=true
N8N_METRICS_INCLUDE_CREDENTIAL_TYPE=false
N8N_METRICS_INCLUDE_NODE_TYPE=false
N8N_METRICS_INCLUDE_WORKFLOW_ID=false

# ---------------------------------------------------------------------------
# Monitoring - Prometheus
# ---------------------------------------------------------------------------
# Data retention duration (default: 30d)
PROMETHEUS_RETENTION=30d

# ---------------------------------------------------------------------------
# Monitoring - Grafana
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 16
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate_a_strong_grafana_password_here

# Optional: comma-separated list of Grafana plugins to pre-install
# Example: grafana-piechart-panel,grafana-worldmap-panel
GRAFANA_PLUGINS=

# ---------------------------------------------------------------------------
# Email / SMTP (required for user invites and password resets)
# ---------------------------------------------------------------------------
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.example.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=smtp_user@example.com
N8N_SMTP_PASS=your_smtp_password
N8N_EMAIL_FROM=n8n@example.com

# ---------------------------------------------------------------------------
# Object Storage - MinIO (optional, for S3-compatible binary data storage)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=generate_a_strong_minio_password_here

# Set to 's3' to enable MinIO for binary data storage (default: 'default')
N8N_DEFAULT_BINARY_DATA_MODE=default
N8N_BINARY_DATA_STORAGE_S3_BUCKET_NAME=n8n-binaries
N8N_BINARY_DATA_STORAGE_S3_BUCKET_REGION=us-east-1

# MinIO S3-compatible credentials (required when N8N_DEFAULT_BINARY_DATA_MODE=s3)
# N8N_BINARY_DATA_STORAGE_S3_ACCESS_KEY=${MINIO_ROOT_USER}
# N8N_BINARY_DATA_STORAGE_S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
# N8N_BINARY_DATA_STORAGE_S3_FORCE_PATH_STYLE=true
# N8N_BINARY_DATA_STORAGE_S3_HOST=minio.${DOMAIN_NAME}
# N8N_BINARY_DATA_STORAGE_S3_PROTOCOL=https
